{
  "manifest_version": 3,
  "name": "Biscit",
  "version": "2.0",
  "description": "Share and sync cookies across devices with admin controls.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "html/index.html"
  },
  "options_page": "html/options.html"
}
