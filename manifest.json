{
  "manifest_version": 3,
  "name": "Biscit",
  "version": "1.0",
  "description": "Share Cookies Across Devices with Admin Controls",
  "permissions": [
    "storage",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "html/popup.html"
  },
  "options_page": "html/admin.html"
}
